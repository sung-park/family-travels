---
import type { Person } from "../lib/schemas";
import Icon from "./Icon.astro";

interface Props {
  people: Person[];
  focusPersonId?: string;
}

const { people, focusPersonId } = Astro.props;

function emojiFor(p: Person) {
  if (p.generation === "child" || p.isFocus) return "🧒";
  if (p.generation === "grandparent") return "👴";
  if (p.side === "nuclear" && p.id === "mom") return "👩";
  if (p.side === "nuclear") return "👨";
  return "👤";
}
---

<ul class="flex flex-wrap gap-2" aria-label="참가자">
  {
    people.map((p) => {
      const focus = p.isFocus || p.id === focusPersonId;
      return (
        <li>
          <span
            class:list={[
              "inline-flex min-h-11 items-center gap-2 rounded-2xl px-3 py-1.5 text-sm font-medium shadow-sm",
              focus
                ? "bg-gradient-to-r from-sky-500 to-teal-500 text-white ring-2 ring-sky-200"
                : "bg-white text-ink ring-1 ring-border",
            ]}
            title={p.nameKo}
          >
            <span
              class:list={[
                "flex size-8 items-center justify-center rounded-xl text-base",
                focus ? "bg-white/20" : "bg-brand-50",
              ]}
              aria-hidden="true"
            >
              {emojiFor(p)}
            </span>
            <span class="flex flex-col leading-tight">
              <span class="font-semibold">{p.nameShort}</span>
              {p.nameKo !== p.nameShort && (
                <span
                  class:list={[
                    "text-[11px] font-normal",
                    focus ? "text-white/80" : "text-muted",
                  ]}
                >
                  {p.nameKo}
                </span>
              )}
            </span>
            {focus && (
              <Icon name="sparkle" class="size-3.5 text-amber-200" />
            )}
          </span>
        </li>
      );
    })
  }
</ul>
