---
import {
  daysUntilStart,
  formatDateRangeKo,
  phaseLabelKo,
  todayInTimeZone,
  tripDayIndex,
} from "../lib/dates";
import type { TripBundle } from "../lib/trip";
import { participantLabels } from "../lib/trip";
import { withBase } from "../lib/paths";
import Icon from "./Icon.astro";

interface Props {
  bundle: TripBundle;
}

const { bundle } = Astro.props;
const { trip, slug, people, phaseAtBuild } = bundle;
const href = withBase(`trips/${slug}/`);
const dateRange = formatDateRangeKo(trip.startDate, trip.endDate);
const who = participantLabels(people);

const todayBuild = todayInTimeZone(trip.timezone);
const dday = daysUntilStart(trip.startDate, todayBuild);
const dayIdx = tripDayIndex(trip.startDate, trip.endDate, todayBuild);
---

<article
  class="trip-card card-lift overflow-hidden rounded-2xl border border-border bg-surface shadow-sm"
  data-start={trip.startDate}
  data-end={trip.endDate}
  data-tz={trip.timezone}
  data-phase={phaseAtBuild}
>
  <a href={href} class="block no-underline text-inherit">
    <div class="hero-panel relative px-5 pb-5 pt-4">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <span
          class="phase-badge inline-flex items-center gap-1 rounded-full bg-white/25 px-2.5 py-1 text-xs font-semibold text-white"
          data-phase-label
        >
          {phaseLabelKo(phaseAtBuild)}
        </span>
        <span
          class="inline-flex size-11 items-center justify-center rounded-2xl bg-white/25 text-2xl"
          aria-hidden="true"
        >
          🏖️
        </span>
      </div>
      <h2 class="mt-3 text-xl font-bold tracking-tight text-white">{trip.title}</h2>
      <p
        class="relative-meta mt-1 text-sm font-semibold text-white/95"
        data-relative
      >
        {
          phaseAtBuild === "pre"
            ? dday === 0
              ? "오늘 출발"
              : `출발까지 D-${dday}`
            : phaseAtBuild === "during" && dayIdx
              ? `여행 ${dayIdx}일차`
              : phaseAtBuild === "post"
                ? "다녀왔어요"
                : ""
        }
      </p>
    </div>

    <div class="space-y-2.5 px-5 py-4">
      <p class="flex items-start gap-2 text-base text-ink">
        <Icon name="calendar" class="mt-0.5 size-5 shrink-0 text-sky-600" />
        <span>{dateRange}</span>
      </p>
      <p class="flex items-center gap-2 text-sm text-muted">
        <Icon name="mapPin" class="size-5 shrink-0 text-rose-500" />
        {trip.destination.cityKo}, {trip.destination.countryKo}
      </p>
      {
        who && (
          <p class="flex items-start gap-2 text-sm text-muted">
            <Icon name="users" class="mt-0.5 size-5 shrink-0 text-violet-600" />
            <span>{who}</span>
          </p>
        )
      }
      <div class="flex items-center justify-between border-t border-border pt-3">
        {
          trip.status === "planned" ? (
            <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-800">
              예약·일정 일부 TBD
            </span>
          ) : (
            <span />
          )
        }
        <span class="inline-flex items-center gap-0.5 text-sm font-semibold text-brand-700">
          자세히 보기
          <Icon name="chevronRight" class="size-4" />
        </span>
      </div>
    </div>
  </a>
</article>

<script>
  function todayInTz(timeZone: string): string {
    return new Intl.DateTimeFormat("en-CA", {
      timeZone,
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(new Date());
  }

  function phase(start: string, end: string, today: string) {
    if (today < start) return "pre";
    if (today > end) return "post";
    return "during";
  }

  function phaseLabel(p: string) {
    if (p === "pre") return "출발 전";
    if (p === "during") return "여행 중";
    return "여행 끝";
  }

  function dayIndex(start: string, end: string, today: string) {
    if (today < start || today > end) return null;
    const s = Date.parse(start + "T00:00:00Z");
    const t = Date.parse(today + "T00:00:00Z");
    return Math.floor((t - s) / 86400000) + 1;
  }

  function dday(start: string, today: string) {
    const s = Date.parse(start + "T00:00:00Z");
    const t = Date.parse(today + "T00:00:00Z");
    return Math.round((s - t) / 86400000);
  }

  document.querySelectorAll<HTMLElement>(".trip-card").forEach((card) => {
    const start = card.dataset.start!;
    const end = card.dataset.end!;
    const tz = card.dataset.tz!;
    const today = todayInTz(tz);
    const p = phase(start, end, today);
    card.dataset.phase = p;
    const badge = card.querySelector("[data-phase-label]");
    if (badge) {
      badge.innerHTML = "";
      const span = document.createElement("span");
      span.textContent = phaseLabel(p);
      badge.append(span);
    }
    const rel = card.querySelector("[data-relative]");
    if (rel) {
      if (p === "pre") {
        const d = dday(start, today);
        rel.textContent = d === 0 ? "오늘 출발" : `출발까지 D-${d}`;
      } else if (p === "during") {
        const i = dayIndex(start, end, today);
        rel.textContent = i ? `여행 ${i}일차` : "여행 중";
      } else {
        rel.textContent = "다녀왔어요";
      }
    }
  });
</script>
