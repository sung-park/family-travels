---
import { withBase } from "../lib/paths";
import type { DayData, Person } from "../lib/schemas";
import Icon from "./Icon.astro";

type Activity = DayData["activities"][number];

export interface ActivityItem extends Activity {
  displayTitle: string;
}

export interface ActivityTone {
  rail: string;
  dot: string;
  time: string;
}

interface Props {
  items: ActivityItem[];
  tone: ActivityTone;
  compact?: boolean;
  peopleById: Map<string, Person>;
}

const { items, tone, compact = false, peopleById } = Astro.props;

function peopleLabel(ids: string[] | undefined): string | null {
  if (!ids || ids.length === 0) return null;
  return ids
    .map((id) => peopleById.get(id)?.nameShort ?? id)
    .join(" · ");
}

function activityImageSrc(path: string | undefined): string | null {
  if (!path) return null;
  if (path.startsWith("http://") || path.startsWith("https://")) return path;
  return withBase(path.replace(/^\//, ""));
}
---

<ul
  class:list={[
    "relative space-y-0 border-l-2",
    tone.rail,
    compact ? "px-3 py-3 pl-7" : "pl-4",
  ]}
>
  {
    items.map((a) => {
      const who = peopleLabel(a.peopleIds);
      const img = activityImageSrc(a.image);
      return (
        <li
          class:list={[
            "relative",
            compact ? "pb-4" : "pb-5",
            "last:pb-0",
          ]}
        >
          <span
            class:list={[
              "absolute top-1.5 size-2.5 rounded-full ring-4 ring-white",
              compact ? "-left-[1.05rem]" : "-left-[1.3rem]",
              tone.dot,
            ]}
          />
          {/*
            Stack layout: time + text always full width, photo below.
            Never put image beside text in narrow plan columns (that forced
            Korean glyphs to wrap vertically).
          */}
          <div class="flex gap-3 text-sm">
            <span
              class:list={[
                "w-12 shrink-0 tabular-nums font-bold leading-6",
                tone.time,
              ]}
            >
              {a.time ?? "—"}
            </span>
            <div class="min-w-0 flex-1 space-y-1.5 overflow-hidden">
              <p class="font-semibold leading-snug break-keep text-ink">
                {a.displayTitle}
              </p>
              {a.place && (
                <p class="flex items-start gap-1 leading-snug break-keep text-muted">
                  <Icon name="mapPin" class="mt-0.5 size-3.5 shrink-0" />
                  <span class="min-w-0">{a.place}</span>
                </p>
              )}
              {a.notes && (
                <p class="leading-relaxed break-keep text-muted">{a.notes}</p>
              )}
              {who && (
                <p class="text-xs font-medium text-violet-700">👥 {who}</p>
              )}
              {img && (
                <div
                  class:list={[
                    "overflow-hidden rounded-xl border border-black/5 bg-slate-100 shadow-sm",
                    compact ? "mt-2 max-w-sm" : "mt-2 max-w-md",
                  ]}
                >
                  <img
                    src={img}
                    alt={a.place ?? a.displayTitle}
                    class="aspect-[16/10] w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
            </div>
          </div>
        </li>
      );
    })
  }
</ul>
