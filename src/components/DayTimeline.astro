---
import { formatDateKo } from "../lib/dates";
import type { DayData, Person } from "../lib/schemas";
import type { TripData } from "../lib/schemas";
import { lodgingById } from "../lib/trip";

interface Props {
  days: Array<DayData & { body?: string }>;
  trip: TripData;
  peopleById: Map<string, Person>;
}

const { days, trip, peopleById } = Astro.props;

function peopleLabel(ids: string[] | undefined): string | null {
  if (!ids || ids.length === 0) return null;
  return ids
    .map((id) => peopleById.get(id)?.nameShort ?? id)
    .join(" · ");
}
---

<div class="space-y-3">
  <div class="flex gap-2 overflow-x-auto pb-1" role="navigation" aria-label="날짜 바로가기">
    {
      days.map((d) => (
        <a
          href={`#day-${d.date}`}
          class="inline-flex min-h-11 shrink-0 items-center rounded-full border border-border bg-surface px-3 text-sm font-medium text-ink no-underline hover:border-brand-600 hover:bg-brand-50"
        >
          {d.date.slice(5).replace("-", "/")}
        </a>
      ))
    }
  </div>

  <ol class="space-y-4">
    {
      days.map((d) => {
        const lodging = lodgingById(trip, d.lodgingId);
        return (
          <li
            id={`day-${d.date}`}
            class="scroll-mt-24 rounded-2xl border border-border bg-surface p-4"
          >
            <h3 class="text-lg font-bold text-ink">
              {formatDateKo(d.date)}
              {d.dayIndex != null && (
                <span class="ml-2 text-sm font-medium text-muted">
                  {d.dayIndex}일차
                </span>
              )}
            </h3>
            <p class="mt-1 font-medium text-ink">{d.title}</p>
            {d.summary && (
              <p class="mt-1 text-sm text-muted">{d.summary}</p>
            )}
            {lodging && (
              <p class="mt-2 text-sm text-brand-800">
                숙소:{" "}
                <a href={`#lodging-${lodging.id}`} class="font-medium">
                  {lodging.name}
                </a>
              </p>
            )}
            {d.activities.length > 0 && (
              <ul class="mt-3 space-y-3 border-t border-border pt-3">
                {d.activities.map((a) => {
                  const who = peopleLabel(a.peopleIds);
                  return (
                    <li class="flex gap-3 text-sm">
                      <span class="w-14 shrink-0 tabular-nums font-semibold text-ink">
                        {a.time ?? "—"}
                      </span>
                      <div>
                        <p class="font-medium text-ink">{a.title}</p>
                        {a.place && (
                          <p class="text-muted">{a.place}</p>
                        )}
                        {a.notes && (
                          <p class="mt-0.5 text-muted">{a.notes}</p>
                        )}
                        {who && (
                          <p class="mt-0.5 text-xs text-brand-700">
                            참가: {who}
                          </p>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        );
      })
    }
  </ol>
</div>
