---
import { formatDateKo } from "../lib/dates";
import type { DayData, Lodging, Person, TripData } from "../lib/schemas";
import { lodgingById } from "../lib/trip";
import ActivityList from "./ActivityList.astro";
import type { ActivityItem, ActivityTone } from "./ActivityList.astro";
import Icon from "./Icon.astro";

interface Props {
  days: Array<DayData & { body?: string }>;
  trip: TripData;
  peopleById: Map<string, Person>;
}

const { days, trip, peopleById } = Astro.props;

type Activity = DayData["activities"][number];
type PlanKey = "common" | "plan1" | "plan2";

interface PlanBucket {
  key: PlanKey;
  label: string;
  blurb: string;
  activities: ActivityItem[];
  tone: ActivityTone & {
    wrap: string;
    head: string;
  };
}

const PLAN1_RE = /^【\s*1안\s*】\s*/;
const PLAN2_RE = /^【\s*2안\s*】\s*/;
const COMMON_SUFFIX_RE = /\s*\(공통\)\s*$/;

const commonTone: ActivityTone & { wrap: string; head: string } = {
  wrap: "border-border bg-white",
  head: "bg-slate-50 text-slate-800",
  rail: "border-sky-200",
  dot: "bg-sky-500",
  time: "text-sky-700",
};

function emptyCommon(label: string, blurb: string): PlanBucket {
  return {
    key: "common",
    label,
    blurb,
    activities: [],
    tone: commonTone,
  };
}

function splitPlans(activities: Activity[]): {
  commonBefore: PlanBucket;
  commonAfter: PlanBucket;
  plan1: PlanBucket;
  plan2: PlanBucket;
  hasPlans: boolean;
} {
  const commonBefore = emptyCommon(
    "공통 (먼저)",
    "어느 안을 골라도 같이 하는 일정",
  );
  const commonAfter = emptyCommon(
    "공통 (이후)",
    "코스 선택 후 다시 합류하는 일정",
  );
  const plan1: PlanBucket = {
    key: "plan1",
    label: "1안 · 완벽한 휴식",
    blurb: "동선 최소 · 마사지 · 유람선",
    activities: [],
    tone: {
      wrap: "border-emerald-200 bg-emerald-50/40",
      head: "bg-emerald-100/80 text-emerald-950",
      rail: "border-emerald-300",
      dot: "bg-emerald-600",
      time: "text-emerald-800",
    },
  };
  const plan2: PlanBucket = {
    key: "plan2",
    label: "2안 · 뷰·미식",
    blurb: "선짜 · 씨푸드 · 야시장·용다리",
    activities: [],
    tone: {
      wrap: "border-violet-200 bg-violet-50/40",
      head: "bg-violet-100/80 text-violet-950",
      rail: "border-violet-300",
      dot: "bg-violet-600",
      time: "text-violet-800",
    },
  };

  const planIndexes: number[] = [];
  activities.forEach((a, i) => {
    if (PLAN1_RE.test(a.title) || PLAN2_RE.test(a.title)) planIndexes.push(i);
  });
  const firstPlan = planIndexes.length ? Math.min(...planIndexes) : -1;
  const lastPlan = planIndexes.length ? Math.max(...planIndexes) : -1;

  activities.forEach((a, i) => {
    if (PLAN1_RE.test(a.title)) {
      plan1.activities.push({
        ...a,
        displayTitle: a.title.replace(PLAN1_RE, ""),
      });
      return;
    }
    if (PLAN2_RE.test(a.title)) {
      plan2.activities.push({
        ...a,
        displayTitle: a.title.replace(PLAN2_RE, ""),
      });
      return;
    }
    const item: ActivityItem = {
      ...a,
      displayTitle: a.title.replace(COMMON_SUFFIX_RE, ""),
    };
    if (firstPlan >= 0 && i > lastPlan) commonAfter.activities.push(item);
    else commonBefore.activities.push(item);
  });

  if (commonAfter.activities.length === 0) {
    commonBefore.label = "공통";
  }
  if (commonBefore.activities.length === 0 && commonAfter.activities.length) {
    commonAfter.label = "공통";
    commonAfter.blurb = "어느 안을 골라도 같이 하는 일정";
  }

  return {
    commonBefore,
    commonAfter,
    plan1,
    plan2,
    hasPlans: plan1.activities.length > 0 || plan2.activities.length > 0,
  };
}

const moodEmoji: Record<string, string> = {
  travel: "✈️",
  rest: "😌",
  family: "👨‍👩‍👧‍👦",
};

interface DayView {
  date: string;
  dayIndex?: number;
  title: string;
  summary?: string;
  body?: string;
  emoji: string;
  lodging?: Lodging;
  hasPlans: boolean;
  plainItems: ActivityItem[];
  commonBefore: PlanBucket;
  commonAfter: PlanBucket;
  planBuckets: PlanBucket[];
}

const dayViews: DayView[] = days.map((d) => {
  const lodging = lodgingById(trip, d.lodgingId);
  const emoji = (d.mood && moodEmoji[d.mood]) || "📅";
  const { commonBefore, commonAfter, plan1, plan2, hasPlans } = splitPlans(
    d.activities,
  );
  const planBuckets = [plan1, plan2].filter((b) => b.activities.length > 0);
  const plainItems = [...commonBefore.activities, ...commonAfter.activities];

  return {
    date: d.date,
    dayIndex: d.dayIndex,
    title: d.title,
    summary: d.summary,
    body: d.body,
    emoji,
    lodging,
    hasPlans,
    plainItems,
    commonBefore,
    commonAfter,
    planBuckets,
  };
});
---

<div class="space-y-3">
  <div
    class="flex gap-2 overflow-x-auto pb-1"
    role="navigation"
    aria-label="날짜 바로가기"
  >
    {
      dayViews.map((d) => (
        <a
          href={`#day-${d.date}`}
          class="inline-flex min-h-11 shrink-0 flex-col items-center justify-center rounded-2xl border border-border bg-surface px-3 py-1.5 text-ink no-underline shadow-sm hover:border-brand-600 hover:bg-brand-50"
        >
          <span class="text-[10px] font-medium text-muted">
            {d.dayIndex != null ? `${d.dayIndex}일` : "·"}
          </span>
          <span class="text-sm font-bold tabular-nums">
            {d.date.slice(5).replace("-", "/")}
          </span>
        </a>
      ))
    }
  </div>

  <ol class="space-y-4">
    {
      dayViews.map((d) => (
        <li
          id={`day-${d.date}`}
          class="card-lift scroll-mt-24 overflow-hidden rounded-2xl border border-border bg-surface shadow-sm"
        >
          <div class="flex items-center gap-3 border-b border-border bg-gradient-to-r from-slate-50 to-sky-50 px-4 py-3">
            <span
              class="flex size-11 items-center justify-center rounded-2xl bg-white text-2xl shadow-sm ring-1 ring-border"
              aria-hidden="true"
            >
              {d.emoji}
            </span>
            <div class="min-w-0">
              <p class="text-xs font-medium text-muted">
                {formatDateKo(d.date)}
                {d.dayIndex != null && ` · ${d.dayIndex}일차`}
              </p>
              <h3 class="truncate text-lg font-bold text-ink">{d.title}</h3>
            </div>
          </div>

          <div class="space-y-3 p-4">
            {d.summary && <p class="text-sm text-muted">{d.summary}</p>}
            {d.lodging && (
              <a
                href={`#lodging-${d.lodging.id}`}
                class="flex items-center gap-2 rounded-xl bg-teal-50 px-3 py-2 text-sm font-medium text-teal-900 no-underline"
              >
                <Icon name="hotel" class="size-4 shrink-0 text-teal-700" />
                <span class="truncate">{d.lodging.name}</span>
              </a>
            )}

            {!d.hasPlans && d.plainItems.length > 0 && (
              <ActivityList
                items={d.plainItems}
                tone={commonTone}
                compact={false}
                peopleById={peopleById}
              />
            )}

            {d.hasPlans && (
              <div class="space-y-3">
                {d.commonBefore.activities.length > 0 && (
                  <section
                    class={`overflow-hidden rounded-xl border ${d.commonBefore.tone.wrap}`}
                    aria-label={d.commonBefore.label}
                  >
                    <header
                      class={`border-b border-black/5 px-3 py-2.5 ${d.commonBefore.tone.head}`}
                    >
                      <p class="text-sm font-bold">{d.commonBefore.label}</p>
                      <p class="text-xs opacity-80">{d.commonBefore.blurb}</p>
                    </header>
                    <ActivityList
                      items={d.commonBefore.activities}
                      tone={d.commonBefore.tone}
                      compact
                      peopleById={peopleById}
                    />
                  </section>
                )}

                <p class="text-center text-xs font-semibold tracking-wide text-muted">
                  아래 중 <span class="text-ink">하루 한 코스만</span> 선택
                </p>

                <div
                  class:list={[
                    "grid gap-3",
                    d.planBuckets.length > 1 && "md:grid-cols-2",
                  ]}
                >
                  {d.planBuckets.map((bucket) => (
                    <section
                      class={`overflow-hidden rounded-xl border ${bucket.tone.wrap}`}
                      aria-label={bucket.label}
                    >
                      <header
                        class={`border-b border-black/5 px-3 py-2.5 ${bucket.tone.head}`}
                      >
                        <p class="text-sm font-bold">{bucket.label}</p>
                        <p class="text-xs opacity-80">{bucket.blurb}</p>
                      </header>
                      <ActivityList
                        items={bucket.activities}
                        tone={bucket.tone}
                        compact
                        peopleById={peopleById}
                      />
                    </section>
                  ))}
                </div>

                {d.commonAfter.activities.length > 0 && (
                  <section
                    class={`overflow-hidden rounded-xl border ${d.commonAfter.tone.wrap}`}
                    aria-label={d.commonAfter.label}
                  >
                    <header
                      class={`border-b border-black/5 px-3 py-2.5 ${d.commonAfter.tone.head}`}
                    >
                      <p class="text-sm font-bold">{d.commonAfter.label}</p>
                      <p class="text-xs opacity-80">{d.commonAfter.blurb}</p>
                    </header>
                    <ActivityList
                      items={d.commonAfter.activities}
                      tone={d.commonAfter.tone}
                      compact
                      peopleById={peopleById}
                    />
                  </section>
                )}
              </div>
            )}

            {d.body?.trim() && (
              <div class="rounded-xl bg-slate-50 px-3 py-2.5 text-sm leading-relaxed text-muted">
                {d.body
                  .trim()
                  .split(/\n+/)
                  .map((para) => (
                    <p class="mb-1.5 last:mb-0">{para}</p>
                  ))}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>
