---
import { formatDateKo, todayInTimeZone } from "../lib/dates";
import type { DayData, Lodging, Person, TripData } from "../lib/schemas";
import { lodgingById } from "../lib/trip";
import ActivityList from "./ActivityList.astro";
import type { ActivityItem, ActivityTone } from "./ActivityList.astro";
import Icon from "./Icon.astro";

interface Props {
  days: Array<DayData & { body?: string }>;
  trip: TripData;
  peopleById: Map<string, Person>;
}

const { days, trip, peopleById } = Astro.props;

type Activity = DayData["activities"][number];
type PlanKey = "common" | "plan1" | "plan2";

interface PlanBucket {
  key: PlanKey;
  label: string;
  blurb: string;
  activities: ActivityItem[];
  tone: ActivityTone & {
    wrap: string;
    head: string;
  };
}

const PLAN1_RE = /^【\s*1안\s*】\s*/;
const PLAN2_RE = /^【\s*2안\s*】\s*/;
const COMMON_SUFFIX_RE = /\s*\(공통\)\s*$/;

const commonTone: ActivityTone & { wrap: string; head: string } = {
  wrap: "border-border bg-white",
  head: "bg-slate-50 text-slate-800",
  rail: "border-sky-200",
  dot: "bg-sky-500",
  time: "text-sky-700",
};

function emptyCommon(label: string, blurb: string): PlanBucket {
  return {
    key: "common",
    label,
    blurb,
    activities: [],
    tone: commonTone,
  };
}

function splitPlans(activities: Activity[]): {
  commonBefore: PlanBucket;
  commonAfter: PlanBucket;
  plan1: PlanBucket;
  plan2: PlanBucket;
  hasPlans: boolean;
} {
  const commonBefore = emptyCommon(
    "공통 (먼저)",
    "어느 안을 골라도 같이 하는 일정",
  );
  const commonAfter = emptyCommon(
    "공통 (이후)",
    "코스 선택 후 다시 합류하는 일정",
  );
  const plan1: PlanBucket = {
    key: "plan1",
    label: "1안 · 밸런스형",
    blurb: "시내 힐링 · 빈원더스 주간 · 올드타운 미식",
    activities: [],
    tone: {
      wrap: "border-emerald-200 bg-emerald-50/40",
      head: "bg-emerald-100/80 text-emerald-950",
      rail: "border-emerald-300",
      dot: "bg-emerald-600",
      time: "text-emerald-800",
    },
  };
  const plan2: PlanBucket = {
    key: "plan2",
    label: "2안 · 호캉스·야간형",
    blurb: "시내 뷰·미식 · 한낮 피하기 · 빈원더스 야간 쇼",
    activities: [],
    tone: {
      wrap: "border-violet-200 bg-violet-50/40",
      head: "bg-violet-100/80 text-violet-950",
      rail: "border-violet-300",
      dot: "bg-violet-600",
      time: "text-violet-800",
    },
  };

  const planIndexes: number[] = [];
  activities.forEach((a, i) => {
    if (PLAN1_RE.test(a.title) || PLAN2_RE.test(a.title)) planIndexes.push(i);
  });
  const firstPlan = planIndexes.length ? Math.min(...planIndexes) : -1;
  const lastPlan = planIndexes.length ? Math.max(...planIndexes) : -1;

  activities.forEach((a, i) => {
    if (PLAN1_RE.test(a.title)) {
      plan1.activities.push({
        ...a,
        displayTitle: a.title.replace(PLAN1_RE, ""),
      });
      return;
    }
    if (PLAN2_RE.test(a.title)) {
      plan2.activities.push({
        ...a,
        displayTitle: a.title.replace(PLAN2_RE, ""),
      });
      return;
    }
    const item: ActivityItem = {
      ...a,
      displayTitle: a.title.replace(COMMON_SUFFIX_RE, ""),
    };
    if (firstPlan >= 0 && i > lastPlan) commonAfter.activities.push(item);
    else commonBefore.activities.push(item);
  });

  if (commonAfter.activities.length === 0) {
    commonBefore.label = "공통";
  }
  if (commonBefore.activities.length === 0 && commonAfter.activities.length) {
    commonAfter.label = "공통";
    commonAfter.blurb = "어느 안을 골라도 같이 하는 일정";
  }

  return {
    commonBefore,
    commonAfter,
    plan1,
    plan2,
    hasPlans: plan1.activities.length > 0 || plan2.activities.length > 0,
  };
}

const moodEmoji: Record<string, string> = {
  travel: "✈️",
  rest: "😌",
  family: "👨‍👩‍👧‍👦",
};

interface DayView {
  date: string;
  dayIndex?: number;
  title: string;
  summary?: string;
  body?: string;
  emoji: string;
  activityCount: number;
  /** Rendered expanded — today during the trip, otherwise the first day. */
  defaultOpen: boolean;
  lodging?: Lodging;
  hasPlans: boolean;
  plainItems: ActivityItem[];
  commonBefore: PlanBucket;
  commonAfter: PlanBucket;
  planBuckets: PlanBucket[];
}

/**
 * Days are collapsed by default so the phone shows a week at a glance.
 * One day starts open — today while travelling, otherwise the first day — and
 * the script below re-picks it in the browser, since the build date is stale.
 */
const buildToday = todayInTimeZone(trip.timezone);
const openDate = days.some((d) => d.date === buildToday)
  ? buildToday
  : days[0]?.date;

const dayViews: DayView[] = days.map((d) => {
  const lodging = lodgingById(trip, d.lodgingId);
  const emoji = (d.mood && moodEmoji[d.mood]) || "📅";
  const { commonBefore, commonAfter, plan1, plan2, hasPlans } = splitPlans(
    d.activities,
  );
  const planBuckets = [plan1, plan2].filter((b) => b.activities.length > 0);
  const plainItems = [...commonBefore.activities, ...commonAfter.activities];

  return {
    date: d.date,
    dayIndex: d.dayIndex,
    title: d.title,
    summary: d.summary,
    body: d.body,
    emoji,
    activityCount: d.activities.length,
    defaultOpen: d.date === openDate,
    lodging,
    hasPlans,
    plainItems,
    commonBefore,
    commonAfter,
    planBuckets,
  };
});
---

<div class="space-y-3" data-day-timeline data-tz={trip.timezone}>
  <div class="flex items-center gap-2">
    <p class="flex-1 text-xs text-muted">
      날짜를 누르면 그날 일정이 펼쳐집니다.
    </p>
    <button
      type="button"
      data-days-toggle
      aria-expanded="false"
      class="inline-flex min-h-9 shrink-0 items-center gap-1.5 rounded-full border border-border bg-surface px-3 text-xs font-semibold text-brand-800 shadow-sm hover:bg-brand-50"
    >
      <Icon name="chevronDown" class="size-3.5 transition-transform" />
      <span data-days-toggle-label>모두 펼치기</span>
    </button>
  </div>

  <div
    class="flex gap-2 overflow-x-auto pb-1"
    role="navigation"
    aria-label="날짜 바로가기"
  >
    {
      dayViews.map((d) => (
        <a
          href={`#day-${d.date}`}
          class="inline-flex min-h-11 shrink-0 flex-col items-center justify-center rounded-2xl border border-border bg-surface px-3 py-1.5 text-ink no-underline shadow-sm hover:border-brand-600 hover:bg-brand-50"
        >
          <span class="text-[10px] font-medium text-muted">
            {d.dayIndex != null ? `${d.dayIndex}일` : "·"}
          </span>
          <span class="text-sm font-bold tabular-nums">
            {d.date.slice(5).replace("-", "/")}
          </span>
        </a>
      ))
    }
  </div>

  <ol class="space-y-4">
    {
      dayViews.map((d) => (
        <li
          id={`day-${d.date}`}
          class="card-lift scroll-mt-24 overflow-hidden rounded-2xl border border-border bg-surface shadow-sm"
        >
          <details
            class="disclosure group"
            data-day={d.date}
            data-open-on-target
            open={d.defaultOpen}
          >
            <summary class="flex cursor-pointer items-start gap-3 border-b border-transparent bg-gradient-to-r from-slate-50 to-sky-50 px-4 py-3 select-none group-open:border-border">
              <span
                class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-white text-2xl shadow-sm ring-1 ring-border"
                aria-hidden="true"
              >
                {d.emoji}
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-medium text-muted">
                  {formatDateKo(d.date)}
                  {d.dayIndex != null && ` · ${d.dayIndex}일차`}
                </p>
                <h3 class="text-lg font-bold break-keep text-ink">{d.title}</h3>
                {/* Collapsed: a one-line gist. Expanded: the full copy below. */}
                {d.summary && (
                  <p class="mt-0.5 text-sm text-muted group-open:hidden">
                    {d.summary}
                  </p>
                )}
                <p class="mt-1 text-xs font-medium text-brand-700 group-open:hidden">
                  일정 {d.activityCount}개 보기
                </p>
              </div>
              <span
                class="mt-1 flex size-7 shrink-0 items-center justify-center rounded-full bg-white text-muted shadow-sm ring-1 ring-border transition-transform duration-200 group-open:rotate-180"
                aria-hidden="true"
              >
                <Icon name="chevronDown" class="size-4" />
              </span>
            </summary>

          <div class="disclosure-body space-y-3 p-4">
            {d.summary && <p class="text-sm text-muted">{d.summary}</p>}
            {d.lodging && (
              <a
                href={`#lodging-${d.lodging.id}`}
                class="flex items-center gap-2 rounded-xl bg-teal-50 px-3 py-2 text-sm font-medium text-teal-900 no-underline"
              >
                <Icon name="hotel" class="size-4 shrink-0 text-teal-700" />
                <span class="truncate">{d.lodging.name}</span>
              </a>
            )}

            {!d.hasPlans && d.plainItems.length > 0 && (
              <ActivityList
                items={d.plainItems}
                tone={commonTone}
                compact={false}
                peopleById={peopleById}
              />
            )}

            {d.hasPlans && (
              <div class="space-y-3">
                {d.commonBefore.activities.length > 0 && (
                  <section
                    class={`overflow-hidden rounded-xl border ${d.commonBefore.tone.wrap}`}
                    aria-label={d.commonBefore.label}
                  >
                    <header
                      class={`border-b border-black/5 px-3 py-2.5 ${d.commonBefore.tone.head}`}
                    >
                      <p class="text-sm font-bold">{d.commonBefore.label}</p>
                      <p class="text-xs opacity-80">{d.commonBefore.blurb}</p>
                    </header>
                    <ActivityList
                      items={d.commonBefore.activities}
                      tone={d.commonBefore.tone}
                      compact
                      peopleById={peopleById}
                    />
                  </section>
                )}

                <p class="text-center text-xs font-semibold tracking-wide text-muted">
                  아래 중 <span class="text-ink">하루 한 코스만</span> 선택
                </p>

                {/*
                  Side-by-side only when the page is wide enough (lg+).
                  Below that, stack so text never collapses into a single glyph column.
                */}
                <div
                  class:list={[
                    "grid grid-cols-1 gap-4",
                    d.planBuckets.length > 1 && "lg:grid-cols-2 lg:gap-5",
                  ]}
                >
                  {d.planBuckets.map((bucket) => (
                    <section
                      class={`min-w-0 overflow-hidden rounded-xl border ${bucket.tone.wrap}`}
                      aria-label={bucket.label}
                    >
                      <header
                        class={`border-b border-black/5 px-4 py-3 ${bucket.tone.head}`}
                      >
                        <p class="text-base font-bold break-keep">
                          {bucket.label}
                        </p>
                        <p class="mt-0.5 text-sm opacity-80 break-keep">
                          {bucket.blurb}
                        </p>
                      </header>
                      <ActivityList
                        items={bucket.activities}
                        tone={bucket.tone}
                        compact
                        peopleById={peopleById}
                      />
                    </section>
                  ))}
                </div>

                {d.commonAfter.activities.length > 0 && (
                  <section
                    class={`overflow-hidden rounded-xl border ${d.commonAfter.tone.wrap}`}
                    aria-label={d.commonAfter.label}
                  >
                    <header
                      class={`border-b border-black/5 px-3 py-2.5 ${d.commonAfter.tone.head}`}
                    >
                      <p class="text-sm font-bold">{d.commonAfter.label}</p>
                      <p class="text-xs opacity-80">{d.commonAfter.blurb}</p>
                    </header>
                    <ActivityList
                      items={d.commonAfter.activities}
                      tone={d.commonAfter.tone}
                      compact
                      peopleById={peopleById}
                    />
                  </section>
                )}
              </div>
            )}

            {d.body?.trim() && (
              <div class="rounded-xl bg-slate-50 px-3 py-2.5 text-sm leading-relaxed text-muted">
                {d.body
                  .trim()
                  .split(/\n+/)
                  .map((para) => (
                    <p class="mb-1.5 last:mb-0">{para}</p>
                  ))}
              </div>
            )}
          </div>
          </details>
        </li>
      ))
    }
  </ol>
</div>

<script>
  /**
   * Two things the static build cannot get right on its own:
   * 1. which day is "today" (the page may have been built weeks earlier),
   * 2. the expand-all toggle for readers who want the whole week at once.
   */
  const root = document.querySelector<HTMLElement>("[data-day-timeline]");

  if (root) {
    const cards = Array.from(
      root.querySelectorAll<HTMLDetailsElement>("details[data-day]"),
    );

    const tz = root.dataset.tz;
    if (tz && cards.length && !location.hash) {
      const today = new Intl.DateTimeFormat("en-CA", {
        timeZone: tz,
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(new Date());
      const todayCard = cards.find((c) => c.dataset.day === today);
      if (todayCard && !todayCard.open) {
        for (const c of cards) c.open = c === todayCard;
      }
    }

    const toggle = root.querySelector<HTMLButtonElement>("[data-days-toggle]");
    const label = root.querySelector<HTMLElement>("[data-days-toggle-label]");

    function syncToggle() {
      if (!toggle || !label) return;
      const allOpen = cards.every((c) => c.open);
      toggle.setAttribute("aria-expanded", String(allOpen));
      label.textContent = allOpen ? "모두 접기" : "모두 펼치기";
      toggle.querySelector("svg")?.classList.toggle("rotate-180", allOpen);
    }

    toggle?.addEventListener("click", () => {
      const expand = !cards.every((c) => c.open);
      for (const c of cards) c.open = expand;
      syncToggle();
    });

    for (const c of cards) c.addEventListener("toggle", syncToggle);
    syncToggle();
  }
</script>
