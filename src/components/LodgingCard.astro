---
import { formatDateKo } from "../lib/dates";
import type { Lodging } from "../lib/schemas";

interface Props {
  lodging: Lodging;
  highlight?: boolean;
}

const { lodging, highlight = false } = Astro.props;
const checkIn = `${formatDateKo(lodging.checkInDate)}${lodging.checkInTime ? ` ${lodging.checkInTime}` : ""}`;
const checkOut = `${formatDateKo(lodging.checkOutDate)}${lodging.checkOutTime ? ` ${lodging.checkOutTime}` : ""}`;
---

<article
  class:list={[
    "rounded-2xl border p-4",
    highlight
      ? "border-brand-600 bg-brand-50"
      : "border-border bg-surface",
  ]}
  id={`lodging-${lodging.id}`}
>
  <p class="text-xs font-medium uppercase tracking-wide text-muted">숙소</p>
  <h3 class="mt-1 text-lg font-bold text-ink">{lodging.name}</h3>
  {
    lodging.nameLocal && (
      <p class="text-sm text-muted">{lodging.nameLocal}</p>
    )
  }
  {
    lodging.room && (
      <p class="mt-2 text-sm font-medium text-ink">{lodging.room}</p>
    )
  }
  {
    lodging.area && <p class="mt-1 text-sm text-muted">{lodging.area}</p>
  }
  <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
    <dt class="text-muted">체크인</dt>
    <dd class="text-ink">{checkIn}</dd>
    <dt class="text-muted">체크아웃</dt>
    <dd class="text-ink">{checkOut}</dd>
  </dl>
  {
    lodging.notesPublic && (
      <p class="mt-3 text-sm leading-relaxed text-ink">{lodging.notesPublic}</p>
    )
  }
  {
    lodging.mapUrl && (
      <p class="mt-3">
        <a
          href={lodging.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700"
        >
          지도 보기
        </a>
      </p>
    )
  }
</article>
