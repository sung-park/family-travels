---
import { formatDateKo } from "../lib/dates";
import type { Lodging } from "../lib/schemas";
import { withBase } from "../lib/paths";
import Icon from "./Icon.astro";

interface Props {
  lodging: Lodging;
  highlight?: boolean;
  index?: number;
}

const { lodging, highlight = false, index = 0 } = Astro.props;
const checkIn = `${formatDateKo(lodging.checkInDate)}${lodging.checkInTime ? ` ${lodging.checkInTime}` : ""}`;
const checkOut = `${formatDateKo(lodging.checkOutDate)}${lodging.checkOutTime ? ` ${lodging.checkOutTime}` : ""}`;

const emojis = ["🌃", "🏊", "🏝️"];
const emoji = emojis[index % emojis.length] ?? "🏨";

const coverSrc = lodging.coverImage
  ? lodging.coverImage.startsWith("http")
    ? lodging.coverImage
    : withBase(lodging.coverImage.replace(/^\//, ""))
  : null;

const fallbackGrad =
  index === 0
    ? "from-indigo-700 via-slate-800 to-slate-900"
    : index === 1
      ? "from-teal-700 via-cyan-800 to-sky-900"
      : "from-emerald-800 via-teal-900 to-slate-900";
---

<article
  class:list={[
    "card-lift overflow-hidden rounded-2xl border shadow-sm",
    highlight
      ? "border-brand-600 ring-2 ring-brand-100"
      : "border-border",
  ]}
  id={`lodging-${lodging.id}`}
>
  <!-- Banner: photo + dark gradient for readable white text -->
  <div class="relative h-40 overflow-hidden sm:h-44">
    {
      coverSrc ? (
        <img
          src={coverSrc}
          alt={`${lodging.name} 전경`}
          class="absolute inset-0 size-full scale-105 object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div
          class:list={[
            "absolute inset-0 bg-gradient-to-br",
            fallbackGrad,
          ]}
        />
      )
    }
    <!-- Blur/dim overlay so title stays readable -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/25"
      aria-hidden="true"
    />
    {
      coverSrc && (
        <div
          class="absolute inset-0 backdrop-blur-[1.5px]"
          aria-hidden="true"
        />
      )
    }
    <div class="absolute inset-0 bg-black/20" aria-hidden="true" />

    <div class="relative flex h-full flex-col justify-between p-4 text-white">
      <div class="flex items-start justify-between gap-2">
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-black/35 px-2.5 py-1 text-xs font-semibold backdrop-blur-sm"
        >
          <span aria-hidden="true">{emoji}</span>
          숙소 {index + 1}
        </span>
        <span
          class="flex size-10 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm"
        >
          <Icon name="hotel" class="size-5" />
        </span>
      </div>
      <div class="min-w-0">
        <h3 class="text-lg font-bold leading-snug drop-shadow-sm">
          {lodging.name}
        </h3>
        {
          lodging.nameLocal && (
            <p class="mt-0.5 truncate text-sm text-white/90">
              {lodging.nameLocal}
            </p>
          )
        }
      </div>
    </div>
  </div>

  <div class="space-y-3 bg-surface p-4">
    {
      lodging.room && (
        <p class="rounded-xl bg-amber-50 px-3 py-2 text-sm font-medium text-amber-900">
          🛏️ {lodging.room}
        </p>
      )
    }
    {
      lodging.area && (
        <p class="flex items-center gap-2 text-sm text-muted">
          <Icon name="mapPin" class="size-4 text-rose-500" />
          {lodging.area}
        </p>
      )
    }
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      <div class="flex gap-2 rounded-xl bg-brand-50/80 px-3 py-2.5">
        <Icon name="checkIn" class="mt-0.5 size-5 shrink-0 text-brand-700" />
        <div>
          <p class="text-xs font-medium text-brand-800">체크인</p>
          <p class="text-sm font-semibold text-ink">{checkIn}</p>
        </div>
      </div>
      <div class="flex gap-2 rounded-xl bg-orange-50 px-3 py-2.5">
        <Icon name="checkOut" class="mt-0.5 size-5 shrink-0 text-orange-700" />
        <div>
          <p class="text-xs font-medium text-orange-800">체크아웃</p>
          <p class="text-sm font-semibold text-ink">{checkOut}</p>
        </div>
      </div>
    </div>
    {
      lodging.notesPublic && (
        <div class="space-y-1.5 rounded-xl bg-slate-50 px-3 py-2.5 text-sm leading-relaxed text-ink">
          {lodging.notesPublic
            .split("\n")
            .map((line) => line.trim())
            .filter(Boolean)
            .map((line) => (
              <p>{line}</p>
            ))}
        </div>
      )
    }
    {
      lodging.phone && (
        <a
          href={`tel:${lodging.phone.replace(/\s/g, "")}`}
          class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-emerald-50 px-4 text-sm font-semibold text-emerald-900 no-underline"
        >
          📞 {lodging.phone}
        </a>
      )
    }
    {
      lodging.mapUrl && (
        <a
          href={lodging.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-brand-50 px-4 text-sm font-semibold text-brand-800 no-underline hover:bg-brand-100"
        >
          <Icon name="mapPin" class="size-4" />
          지도 보기
        </a>
      )
    }
  </div>
</article>
