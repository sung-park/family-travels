---
import BaseHead from "../components/BaseHead.astro";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  path?: string;
  noIndex?: boolean;
}

const { title, description, image, path, noIndex } = Astro.props;
const homeHref = withBase("/");
const aboutHref = withBase("about/");
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      path={path}
      noIndex={noIndex}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="border-b border-border bg-surface">
      <div
        class="mx-auto flex max-w-lg items-center justify-between gap-3 px-4 py-3"
      >
        <a
          href={homeHref}
          class="text-[1.05rem] font-semibold text-ink no-underline hover:text-brand-700"
        >
          우리 가족 여행
        </a>
        <nav class="flex items-center gap-1" aria-label="주요 메뉴">
          <a
            href={homeHref}
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg px-3 text-sm font-medium text-ink no-underline hover:bg-brand-50"
          >
            홈
          </a>
          <a
            href={aboutHref}
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg px-3 text-sm font-medium text-ink no-underline hover:bg-brand-50"
          >
            소개
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-lg flex-1 px-4 py-6">
      <slot />
    </main>

    <footer class="border-t border-border bg-surface">
      <div class="mx-auto max-w-lg px-4 py-5 text-sm text-muted">
        <p class="mb-1">시온이와 함께하는 가족 여행 일정 공유</p>
        <p class="text-xs leading-relaxed">
          카톡 인앱 브라우저에서 지도·전화가 안 되면 오른쪽 위 메뉴에서
          Safari/Chrome으로 열어 주세요.
        </p>
      </div>
    </footer>
  </body>
</html>
