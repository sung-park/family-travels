---
import BaseHead from "../components/BaseHead.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  path?: string;
  noIndex?: boolean;
}

const { title, description, image, path, noIndex } = Astro.props;
const homeHref = withBase("/");
const aboutHref = withBase("about/");
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      path={path}
      noIndex={noIndex}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-40 border-b border-border/80 bg-surface/90 backdrop-blur-md">
      <div
        class="mx-auto flex w-full max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8"
      >
        <a
          href={homeHref}
          class="flex items-center gap-2 text-[1.05rem] font-semibold text-ink no-underline hover:text-brand-700"
        >
          <span
            class="inline-flex size-9 items-center justify-center rounded-xl bg-gradient-to-br from-sky-400 to-teal-500 text-white shadow-sm"
          >
            <Icon name="beach" class="size-5" />
          </span>
          우리 가족 여행
        </a>
        <nav class="flex items-center gap-1" aria-label="주요 메뉴">
          <a
            href={homeHref}
            class="inline-flex min-h-11 items-center justify-center gap-1.5 rounded-xl px-3 text-sm font-medium text-ink no-underline hover:bg-brand-50"
          >
            <Icon name="home" class="size-4 text-brand-700" />
            홈
          </a>
          <a
            href={aboutHref}
            class="inline-flex min-h-11 items-center justify-center gap-1.5 rounded-xl px-3 text-sm font-medium text-ink no-underline hover:bg-brand-50"
          >
            <Icon name="info" class="size-4 text-brand-700" />
            소개
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6 sm:px-6 sm:py-8 lg:px-8 lg:py-10">
      <slot />
    </main>

    <footer class="mt-auto border-t border-border bg-surface/80">
      <div class="mx-auto w-full max-w-5xl px-4 py-5 text-sm text-muted sm:px-6 lg:px-8">
        <p class="mb-1 flex items-center gap-2 font-medium text-ink">
          <Icon name="sparkle" class="size-4 text-amber-400" />
          시온이와 함께하는 가족 여행
        </p>
        <p class="text-xs leading-relaxed">
          카톡 인앱 브라우저에서 지도·전화가 안 되면 오른쪽 위 메뉴에서
          Safari/Chrome으로 열어 주세요.
        </p>
      </div>
    </footer>

    <script>
      /**
       * Anchors (#sec-days, #day-2026-09-05, #lodging-…) can point inside a
       * collapsed <details>. Open everything on the way to the target — plus
       * the target's own block when it is marked [data-open-on-target] — then
       * re-scroll, because expanding shifts the layout under the browser's
       * first jump.
       */
      function revealTarget(hash: string, scroll: boolean) {
        const id = decodeURIComponent(hash.replace(/^#/, ""));
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;

        for (
          let node: HTMLElement | null = target;
          node;
          node = node.parentElement
        ) {
          if (node instanceof HTMLDetailsElement) node.open = true;
        }
        if (target instanceof HTMLDetailsElement) target.open = true;
        target
          .querySelectorAll<HTMLDetailsElement>(
            ":scope > details[data-open-on-target]",
          )
          .forEach((d) => {
            d.open = true;
          });

        if (!scroll) return;
        requestAnimationFrame(() => {
          target.scrollIntoView({ block: "start", behavior: "smooth" });
        });
      }

      document.addEventListener("click", (e) => {
        const link = (
          e.target as HTMLElement | null
        )?.closest<HTMLAnchorElement>('a[href^="#"]');
        if (!link) return;
        const hash = link.getAttribute("href") ?? "";
        if (hash.length < 2) return;
        // Open before the browser jumps, so it lands on the expanded layout.
        revealTarget(hash, false);
      });

      window.addEventListener("hashchange", () =>
        revealTarget(location.hash, true),
      );

      if (location.hash) revealTarget(location.hash, true);
    </script>
  </body>
</html>
