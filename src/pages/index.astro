---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TripCard from "../components/TripCard.astro";
import { getTravelPhase, todayInTimeZone } from "../lib/dates";
import { getAllTripBundles } from "../lib/trip";

const bundles = (await getAllTripBundles()).filter(
  (b) => b.trip.status !== "idea" && b.trip.status !== "cancelled",
);

const upcoming = bundles.filter((b) => {
  const today = todayInTimeZone(b.trip.timezone);
  return getTravelPhase(b.trip.startDate, b.trip.endDate, today) === "pre";
});
const ongoing = bundles.filter((b) => {
  const today = todayInTimeZone(b.trip.timezone);
  return getTravelPhase(b.trip.startDate, b.trip.endDate, today) === "during";
});
const past = bundles.filter((b) => {
  const today = todayInTimeZone(b.trip.timezone);
  return getTravelPhase(b.trip.startDate, b.trip.endDate, today) === "post";
});
---

<BaseLayout
  title="우리 가족 여행"
  description="시온이 중심 우리 가족 여행 일정 · 숙소 · 교통 공유"
  path="/"
>
  <section class="space-y-8">
    <div
      class="hero-panel relative overflow-hidden rounded-3xl px-5 py-6 shadow-md"
    >
      <div class="relative z-10">
        <p class="text-sm font-medium text-white/90">Family Travels</p>
        <h1 class="mt-1 text-2xl font-bold tracking-tight text-white">
          우리 가족 여행
        </h1>
        <p class="mt-2 max-w-[20rem] text-sm leading-relaxed text-white/95">
          시온이를 중심으로 일정·숙소·교통을 한곳에서 공유해요.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          <li
            class="inline-flex items-center gap-1.5 rounded-full bg-white/25 px-3 py-1.5 text-xs font-semibold text-white"
          >
            <Icon name="calendar" class="size-3.5" /> 일정
          </li>
          <li
            class="inline-flex items-center gap-1.5 rounded-full bg-white/25 px-3 py-1.5 text-xs font-semibold text-white"
          >
            <Icon name="hotel" class="size-3.5" /> 숙소
          </li>
          <li
            class="inline-flex items-center gap-1.5 rounded-full bg-white/25 px-3 py-1.5 text-xs font-semibold text-white"
          >
            <Icon name="plane" class="size-3.5" /> 항공
          </li>
        </ul>
      </div>
      <div
        class="pointer-events-none absolute -right-2 -top-2 text-7xl opacity-50 select-none"
        aria-hidden="true"
      >
        ✈️
      </div>
      <div
        class="pointer-events-none absolute bottom-2 right-4 text-5xl opacity-55 select-none"
        aria-hidden="true"
      >
        🌴
      </div>
    </div>

    {
      bundles.length === 0 && (
        <div class="rounded-2xl border border-dashed border-border bg-surface p-6 text-center">
          <div class="mx-auto mb-3 flex size-14 items-center justify-center rounded-2xl bg-brand-50 text-3xl">
            🗺️
          </div>
          <p class="font-medium text-ink">아직 등록된 여행이 없어요</p>
        </div>
      )
    }

    {
      ongoing.length > 0 && (
        <section class="space-y-3" aria-labelledby="sec-ongoing">
          <SectionTitle id="sec-ongoing" icon="sun" title="지금 여행 중" tone="coral" />
          {ongoing.map((b) => (
            <TripCard bundle={b} />
          ))}
        </section>
      )
    }

    {
      upcoming.length > 0 && (
        <section class="space-y-3" aria-labelledby="sec-upcoming">
          <SectionTitle
            id="sec-upcoming"
            icon="plane"
            title="다가오는 여행"
            tone="sky"
          />
          {upcoming.map((b) => (
            <TripCard bundle={b} />
          ))}
        </section>
      )
    }

    {
      past.length > 0 && (
        <section class="space-y-3" aria-labelledby="sec-past">
          <SectionTitle id="sec-past" icon="beach" title="지난 여행" tone="sand" />
          {past.map((b) => (
            <TripCard bundle={b} />
          ))}
        </section>
      )
    }
  </section>
</BaseLayout>
